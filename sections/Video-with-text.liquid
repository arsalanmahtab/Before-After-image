{% liquid
  assign section_id = section.id
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign has_videos = false
  if video_blocks.size > 0
    assign has_videos = true
  endif
  assign show_arrows = false
  if video_blocks.size > 1
    assign show_arrows = true
  endif
%}

<div
  class="spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}{% if section.settings.section_background != blank %}; background: {{ section.settings.section_background }}{% endif %}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  data-video-height="{{ section.settings.video_height }}"
>
  <div class="video-with-text__container">
    {% if section.settings.heading != blank %}
      <h2 class="video-with-text__heading {{ section.settings.heading_size }} color-{{ section.settings.heading_color_scheme }}"
          {% if section.settings.heading_gradient %}
          style="background: {{ section.settings.heading_gradient }}; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
          {% endif %}
      >
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="video-with-text__subheading {{ section.settings.subheading_size }} color-{{ section.settings.subheading_color_scheme }}"
           {% if section.settings.subheading_gradient %}
           style="background: {{ section.settings.subheading_gradient }}; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
           {% endif %}
      >
        {{ section.settings.subheading | escape }}
      </div>
    {% endif %}

    {% if has_videos %}
      <div class="video-with-text__video-container">
        <div class="video-slideshow" data-video-count="{{ video_blocks.size }}">
          <div class="video-slideshow__container">
            {% for block in video_blocks %}
              <div 
                class="video-slide {% if forloop.first %}active{% endif %}"
                data-slide-index="{{ forloop.index0 }}"
                data-block-id="{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <div class="video-slide__content">
                  {% if block.settings.video != blank %}
                    <div class="video-slide__media">
                      <!-- Volume Control (only show on active video) -->
                      <button
                        class="button button-unstyled video-controls__mute-button {% unless forloop.first %}hidden{% endunless %}"
                        type="button"
                        aria-label="{{ 'accessibility.mute_video' | t }}"
                      >
                        <span class="video-controls__mute-icon icon-volume">
                          <span class="visually-hidden">{{ 'accessibility.mute_video' | t }}</span>
                          <span class="svg-wrapper icon-volume">
                            {{- 'icon-volume.svg' | inline_asset_content -}}
                          </span>
                        </span>
                        <span class="video-controls__mute-icon icon-volume-mute hidden">
                          <span class="visually-hidden">{{ 'accessibility.unmute_video' | t }}</span>
                          <span class="svg-wrapper icon-volume-mute">
                            {{- 'icon-volume-mute.svg' | inline_asset_content -}}
                          </span>
                        </span>
                      </button>

                      <!-- Video Player -->
                      {% if block.settings.video.host == 'youtube' %}
                        {{
                          block.settings.video
                          | external_video_url: autoplay: false, loop: true, playlist: block.settings.video.external_id, mute: '1', controls: false, enablejsapi: true
                          | external_video_tag: data-video-type: 'youtube', class: 'video-player'
                        }}
                      {% elsif block.settings.video.host == 'vimeo' %}
                        {{
                          block.settings.video
                          | external_video_url: autoplay: false, loop: true, muted: '1', controls: false, api: true
                          | external_video_tag: data-video-type: 'vimeo', class: 'video-player'
                        }}
                      {% else %}
                        {{ block.settings.video | video_tag: image_size: '2500x', autoplay: false, loop: true, muted: true, controls: false, class: 'video-player' }}
                      {% endif %}
                    </div>
                  {% else %}
                    <div class="video-slide__placeholder">
                      <placeholder-image
                        class="placeholder-video"
                        data-block-id="{{ section_id }}-{{ block.id }}"
                        data-type="general"
                      ></placeholder-image>
                      <span class="video-slide__placeholder-icon icon-play">
                        <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
                        <span class="svg-wrapper icon-play">
                          {{- 'icon-play.svg' | inline_asset_content -}}
                        </span>
                      </span>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Navigation Arrows Below Video -->
          {% if show_arrows %}
            <div class="video-slideshow__navigation">
              <div class="navigation-arrows">
                <button
                  class="slideshow-arrow slideshow-arrow--previous"
                  type="button"
                  aria-label="{{ 'accessibility.previous_slide' | t }}"
                >
                  <span class="svg-wrapper icon-arrow">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                </button>
                <button
                  class="slideshow-arrow slideshow-arrow--next"
                  type="button"
                  aria-label="{{ 'accessibility.next_slide' | t }}"
                >
                  <span class="svg-wrapper icon-arrow">
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                </button>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

